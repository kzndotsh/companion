# Copy to .env and fill in the keys. Everything below the keys is optional: each line shows its
# default, commented out. README.md ("Settings") says what each one does.

# --- Keys -----------------------------------------------------------------------------------------

OPENROUTER_API_KEY=            # models are called through OpenRouter
# ANTHROPIC_API_KEY=           # only without an OpenRouter key: Claude talks, with no roleplay model or standby

# Telegram (the default platform)
TELEGRAM_BOT_TOKEN=            # from BotFather
TELEGRAM_USER_ID=              # the one Telegram user the bot answers

# Discord instead: set COMPANION_PLATFORM=discord (setup: docs/dev/delivery.md)
# DISCORD_BOT_TOKEN=           # from the Discord Developer Portal
# DISCORD_USER_ID=             # the one Discord user the bot answers

# --- Models ---------------------------------------------------------------------------------------

# COMPANION_EVERYDAY_MODEL=openai/gpt-6-luna
# COMPANION_ROLEPLAY_MODEL=deepseek/deepseek-v4.1-flash     # none: the everyday model plays scenes
# COMPANION_EVERYDAY_STANDBY=deepseek/deepseek-v4.1-flash   # the roleplay model; none turns it off
# COMPANION_JUDGE_MODEL=anthropic/claude-haiku-5.5
# COMPANION_JUDGE_STANDBY=deepseek/deepseek-v4.1-flash      # none disables it
# COMPANION_JUDGE_ROUTES=crisis=deepseek/deepseek-v4.1-flash  # judge=provider/model,...; none
# COMPANION_EMBED_MODEL=openai/text-embedding-3-small

# --- Behaviour ------------------------------------------------------------------------------------

# COMPANION_PLATFORM=telegram          # telegram | discord
# COMPANION_CHARACTER=                 # e.g. mika: lays data/characters/mika.md over the persona
# COMPANION_ROUTE_INTIMATE=off         # on lets intimate talk go to the roleplay model (ADR 0017)
# COMPANION_LISTEN=on                  # on | off
# COMPANION_MOOD=on                    # on | shadow | off
# COMPANION_REDRAW=on                  # on | off
# COMPANION_PACE=natural               # off | quick | natural | slow
# COMPANION_SPLIT=on                   # on | off
# COMPANION_RELEVANCE=on               # on | shadow | off
# COMPANION_EPISODES=on                # on | shadow | off
# COMPANION_MARKS=on                   # on | off
# COMPANION_HEDGED_PLANS=loose         # loose | off
# COMPANION_REMINDERS=on               # on | off
# COMPANION_CALENDAR=on                # on | off
# COMPANION_NOW=shadow                 # on | shadow | off
# COMPANION_HISTORY=shadow             # on | shadow | off
# COMPANION_INTIMATE_MEMORY=on         # on | shadow | off
# COMPANION_FOCUS=on                   # on | off
# COMPANION_LORE=on                    # on | shadow | off

# --- Reaching out, promises, the re-read and the crisis path --------------------------------------

# COMPANION_INITIATIVE=shadow          # shadow | off
# COMPANION_REACH=warm                 # rare | light | normal | warm | clingy | off
# COMPANION_REREAD=on                  # on | shadow | off
# COMPANION_PROMISES=shadow            # shadow | off
# COMPANION_CRISIS=on                  # on | shadow | off

# --- Running --------------------------------------------------------------------------------------

# COMPANION_DAILY_CAP_USD=10           # dollars a day; off removes the cap
# COMPANION_BACKUP_DIR=data/backups    # another drive survives a disk failure
# COMPANION_DB=                        # the one database in data/, for the CLI commands
# COMPANION_PROMPT_OVERRIDES=          # e.g. system/ack=v1,notes/length=v2
